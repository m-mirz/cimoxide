  <!-- SvVoltage.v:limits, C:456 -->

  <!-- OK: SvVoltage.v within [90, 110] -->
  <cim:TopologicalNode rdf:ID="TN.OK"/>
  <cim:Terminal rdf:ID="TERM.OK">
    <cim:Terminal.TopologicalNode rdf:resource="#TN.OK" />
  </cim:Terminal>
  <cim:OperationalLimitSet rdf:ID="OLS.OK">
    <cim:OperationalLimitSet.Terminal rdf:resource="#TERM.OK" />
  </cim:OperationalLimitSet>
  <cim:OperationalLimitType rdf:ID="OLT.OK.HIGH">
    <cim:OperationalLimitType.direction rdf:resource="http://iec.ch/TC57/CIM100#OperationalLimitDirectionKind.high" />
  </cim:OperationalLimitType>
  <cim:OperationalLimitType rdf:ID="OLT.OK.LOW">
    <cim:OperationalLimitType.direction rdf:resource="http://iec.ch/TC57/CIM100#OperationalLimitDirectionKind.low" />
  </cim:OperationalLimitType>
