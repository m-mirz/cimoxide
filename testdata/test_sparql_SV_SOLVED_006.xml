  </cim:VoltageLimit>
  <cim:VoltageLimit rdf:ID="VL.BAD.LOW">
    <cim:OperationalLimit.OperationalLimitSet rdf:resource="#OLS.BAD" />
    <cim:OperationalLimit.OperationalLimitType rdf:resource="#OLT.BAD.LOW" />
