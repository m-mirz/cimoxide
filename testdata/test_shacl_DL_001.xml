<?xml version="1.0" encoding="utf-8" ?>
<rdf:RDF xmlns:cim="http://iec.ch/TC57/CIM100#" xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#">
  <!-- Required Diagram object -->
  <cim:Diagram rdf:ID="Diagram.REF">
    <cim:IdentifiedObject.mRID>Diagram.REF</cim:IdentifiedObject.mRID>
    <cim:IdentifiedObject.name>Diagram-REF</cim:IdentifiedObject.name>
    <cim:Diagram.orientation rdf:resource="cim:OrientationKind.positive"/>
  </cim:Diagram>

  <!-- Target objects for DiagramObject.IdentifiedObject -->
  <cim:SynchronousMachine rdf:ID="SynchronousMachine.SM1">
    <cim:IdentifiedObject.mRID>SynchronousMachine.SM1</cim:IdentifiedObject.mRID>
    <cim:IdentifiedObject.name>SM1</cim:IdentifiedObject.name>
  </cim:SynchronousMachine>
  <cim:GeneratingUnit rdf:ID="GeneratingUnit.GU1">
    <cim:IdentifiedObject.mRID>GeneratingUnit.GU1</cim:IdentifiedObject.mRID>
    <cim:IdentifiedObject.name>GU1</cim:IdentifiedObject.name>
  </cim:GeneratingUnit>

  <!-- DiagramObject.OK: IdentifiedObject points to SynchronousMachine (valid) -->
  <cim:DiagramObject rdf:ID="DiagramObject.OK">
    <cim:IdentifiedObject.mRID>DiagramObject.OK</cim:IdentifiedObject.mRID>
    <cim:IdentifiedObject.name>DO-OK</cim:IdentifiedObject.name>
    <cim:DiagramObject.Diagram rdf:resource="#Diagram.REF" />
    <cim:DiagramObject.IdentifiedObject rdf:resource="#SynchronousMachine.SM1" />
  </cim:DiagramObject>

  <!-- DiagramObject.BAD: IdentifiedObject points to GeneratingUnit (invalid) -->
  <cim:DiagramObject rdf:ID="DiagramObject.BAD">
    <cim:IdentifiedObject.mRID>DiagramObject.BAD</cim:IdentifiedObject.mRID>
    <cim:IdentifiedObject.name>DO-BAD</cim:IdentifiedObject.name>
    <cim:DiagramObject.Diagram rdf:resource="#Diagram.REF" />
    <cim:DiagramObject.IdentifiedObject rdf:resource="#GeneratingUnit.GU1" />
  </cim:DiagramObject>

  <!-- TextDiagramObject.BAD: IdentifiedObject points to GeneratingUnit (invalid) -->
  <cim:TextDiagramObject rdf:ID="TextDiagramObject.BAD">
    <cim:IdentifiedObject.mRID>TextDiagramObject.BAD</cim:IdentifiedObject.mRID>
    <cim:IdentifiedObject.name>TDO-BAD</cim:IdentifiedObject.name>
    <cim:DiagramObject.Diagram rdf:resource="#Diagram.REF" />
    <cim:DiagramObject.IdentifiedObject rdf:resource="#GeneratingUnit.GU1" />
    <cim:TextDiagramObject.text>test</cim:TextDiagramObject.text>
  </cim:TextDiagramObject>
</rdf:RDF>
