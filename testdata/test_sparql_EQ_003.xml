<?xml version="1.0" encoding="utf-8" ?>
<rdf:RDF xmlns:cim="http://iec.ch/TC57/CIM100#" xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#">
  <!-- LoadResponseCharacteristic.exponentModel:exponent/coefficient/coefficientSum -->
  <cim:LoadResponseCharacteristic rdf:ID="LRC.EXP.OK">
    <cim:LoadResponseCharacteristic.exponentModel>true</cim:LoadResponseCharacteristic.exponentModel>
    <cim:LoadResponseCharacteristic.pFrequencyExponent>1.0</cim:LoadResponseCharacteristic.pFrequencyExponent>
    <cim:LoadResponseCharacteristic.pVoltageExponent>1.0</cim:LoadResponseCharacteristic.pVoltageExponent>
    <cim:LoadResponseCharacteristic.qFrequencyExponent>2.0</cim:LoadResponseCharacteristic.qFrequencyExponent>
    <cim:LoadResponseCharacteristic.qVoltageExponent>2.0</cim:LoadResponseCharacteristic.qVoltageExponent>
  </cim:LoadResponseCharacteristic>
  <cim:LoadResponseCharacteristic rdf:ID="LRC.EXP.BAD">
    <cim:LoadResponseCharacteristic.exponentModel>true</cim:LoadResponseCharacteristic.exponentModel>
    <cim:LoadResponseCharacteristic.pFrequencyExponent>1.0</cim:LoadResponseCharacteristic.pFrequencyExponent>
    <cim:LoadResponseCharacteristic.pVoltageExponent>1.0</cim:LoadResponseCharacteristic.pVoltageExponent>
    <cim:LoadResponseCharacteristic.qFrequencyExponent>2.0</cim:LoadResponseCharacteristic.qFrequencyExponent>
    <!-- qVoltageExponent missing: incomplete exponential model -->
  </cim:LoadResponseCharacteristic>
  <cim:LoadResponseCharacteristic rdf:ID="LRC.COEF.OK">
    <cim:LoadResponseCharacteristic.exponentModel>false</cim:LoadResponseCharacteristic.exponentModel>
    <cim:LoadResponseCharacteristic.pConstantCurrent>0.3</cim:LoadResponseCharacteristic.pConstantCurrent>
    <cim:LoadResponseCharacteristic.pConstantImpedance>0.3</cim:LoadResponseCharacteristic.pConstantImpedance>
    <cim:LoadResponseCharacteristic.pConstantPower>0.4</cim:LoadResponseCharacteristic.pConstantPower>
    <cim:LoadResponseCharacteristic.qConstantCurrent>0.2</cim:LoadResponseCharacteristic.qConstantCurrent>
    <cim:LoadResponseCharacteristic.qConstantImpedance>0.3</cim:LoadResponseCharacteristic.qConstantImpedance>
    <cim:LoadResponseCharacteristic.qConstantPower>0.5</cim:LoadResponseCharacteristic.qConstantPower>
  </cim:LoadResponseCharacteristic>
  <cim:LoadResponseCharacteristic rdf:ID="LRC.COEF.BAD">
    <cim:LoadResponseCharacteristic.exponentModel>false</cim:LoadResponseCharacteristic.exponentModel>
    <cim:LoadResponseCharacteristic.pConstantCurrent>0.3</cim:LoadResponseCharacteristic.pConstantCurrent>
    <cim:LoadResponseCharacteristic.pConstantImpedance>0.3</cim:LoadResponseCharacteristic.pConstantImpedance>
    <cim:LoadResponseCharacteristic.pConstantPower>0.4</cim:LoadResponseCharacteristic.pConstantPower>
    <cim:LoadResponseCharacteristic.qConstantCurrent>0.2</cim:LoadResponseCharacteristic.qConstantCurrent>
    <cim:LoadResponseCharacteristic.qConstantImpedance>0.3</cim:LoadResponseCharacteristic.qConstantImpedance>
    <!-- qConstantPower missing: incomplete coefficient model -->
  </cim:LoadResponseCharacteristic>
  <cim:LoadResponseCharacteristic rdf:ID="LRC.SUM.BAD">
    <cim:LoadResponseCharacteristic.exponentModel>false</cim:LoadResponseCharacteristic.exponentModel>
    <cim:LoadResponseCharacteristic.pConstantCurrent>0.5</cim:LoadResponseCharacteristic.pConstantCurrent>
    <cim:LoadResponseCharacteristic.pConstantImpedance>0.3</cim:LoadResponseCharacteristic.pConstantImpedance>
    <cim:LoadResponseCharacteristic.pConstantPower>0.3</cim:LoadResponseCharacteristic.pConstantPower>
    <!-- p sum = 1.1 -->
    <cim:LoadResponseCharacteristic.qConstantCurrent>0.3</cim:LoadResponseCharacteristic.qConstantCurrent>
    <cim:LoadResponseCharacteristic.qConstantImpedance>0.3</cim:LoadResponseCharacteristic.qConstantImpedance>
    <cim:LoadResponseCharacteristic.qConstantPower>0.3</cim:LoadResponseCharacteristic.qConstantPower>
    <!-- q sum = 0.9 -->
  </cim:LoadResponseCharacteristic>
</rdf:RDF>
