{
  "name": "cimoxide",
  "displayName": "cimoxide — CGMES & NC",
  "description": "SHACL validation, hover, go to definition and completion for ENTSO-E CGMES and Network Code RDF/XML — and an MCP server to ask a chat about your model",
  "version": "0.5.1",
  "publisher": "m-mirz",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/m-mirz/cimoxide"
  },
  "homepage": "https://github.com/m-mirz/cimoxide",
  "keywords": [
    "cim",
    "cgmes",
    "entsoe",
    "rdf",
    "shacl",
    "power systems"
  ],
  "categories": [
    "Linters",
    "Programming Languages",
    "AI"
  ],
  "engines": {
    "vscode": "^1.101.0"
  },
  "activationEvents": [
    "onLanguage:xml",
    "onMcpServerDefinitionProvider:cimoxide"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "cimoxide.revalidate",
        "title": "Revalidate model set",
        "category": "cimoxide"
      },
      {
        "command": "cimoxide.showGrid",
        "title": "Show grid",
        "category": "cimoxide",
        "icon": "$(type-hierarchy)"
      },
      {
        "command": "cimoxide.restartServer",
        "title": "Restart language server",
        "category": "cimoxide"
      },
      {
        "command": "cimoxide.model.refresh",
        "title": "Refresh",
        "category": "cimoxide",
        "icon": "$(refresh)"
      },
      {
        "command": "cimoxide.model.onlyFindings",
        "title": "Show only objects with findings",
        "category": "cimoxide",
        "icon": "$(filter)"
      },
      {
        "command": "cimoxide.model.allObjects",
        "title": "Show all objects",
        "category": "cimoxide",
        "icon": "$(filter-filled)"
      },
      {
        "command": "cimoxide.model.showInGrid",
        "title": "Show in grid",
        "category": "cimoxide",
        "icon": "$(type-hierarchy)"
      },
      {
        "command": "cimoxide.model.showInside",
        "title": "Show inside",
        "category": "cimoxide",
        "icon": "$(zoom-in)"
      },
      {
        "command": "cimoxide.model.open",
        "title": "Open definition",
        "category": "cimoxide"
      },
      {
        "command": "cimoxide.model.reveal",
        "title": "Reveal in CIM Model",
        "category": "cimoxide"
      }
    ],
    "views": {
      "explorer": [
        {
          "id": "cimoxide.model",
          "name": "CIM Model",
          "when": "cimoxide.model.active"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "cimoxide.model",
        "contents": "No model set yet: open a CGMES or NC file. Its model set (every CIM file in its directory) is listed here once validated: by region, substation and voltage level, by area and by class, each object with its findings."
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "cimoxide.showGrid",
          "when": "resourceLangId == xml",
          "group": "navigation"
        }
      ],
      "view/title": [
        {
          "command": "cimoxide.model.onlyFindings",
          "when": "view == cimoxide.model && !cimoxide.model.onlyFindings",
          "group": "navigation"
        },
        {
          "command": "cimoxide.model.allObjects",
          "when": "view == cimoxide.model && cimoxide.model.onlyFindings",
          "group": "navigation"
        },
        {
          "command": "cimoxide.model.refresh",
          "when": "view == cimoxide.model",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "cimoxide.model.showInGrid",
          "when": "view == cimoxide.model && viewItem =~ /\\bgrid\\b/",
          "group": "inline"
        },
        {
          "command": "cimoxide.model.showInside",
          "when": "view == cimoxide.model && viewItem =~ /\\binside\\b/",
          "group": "inline"
        },
        {
          "command": "cimoxide.model.showInGrid",
          "when": "view == cimoxide.model && viewItem =~ /\\bgrid\\b/",
          "group": "navigation@1"
        },
        {
          "command": "cimoxide.model.showInside",
          "when": "view == cimoxide.model && viewItem =~ /\\binside\\b/",
          "group": "navigation@2"
        }
      ],
      "commandPalette": [
        {
          "command": "cimoxide.model.onlyFindings",
          "when": "false"
        },
        {
          "command": "cimoxide.model.allObjects",
          "when": "false"
        },
        {
          "command": "cimoxide.model.showInGrid",
          "when": "false"
        },
        {
          "command": "cimoxide.model.showInside",
          "when": "false"
        },
        {
          "command": "cimoxide.model.open",
          "when": "false"
        }
      ],
      "editor/context": [
        {
          "command": "cimoxide.model.reveal",
          "when": "resourceLangId == xml && cimoxide.model.active",
          "group": "navigation@90"
        }
      ]
    },
    "mcpServerDefinitionProviders": [
      {
        "id": "cimoxide",
        "label": "cimoxide — CGMES & NC models"
      }
    ],
    "configuration": {
      "title": "cimoxide",
      "properties": {
        "cimoxide.server.path": {
          "type": "string",
          "default": "",
          "markdownDescription": "Path to a `cimlsp` binary. Empty: the one bundled with the extension, else `cimlsp` on `PATH`."
        },
        "cimoxide.validation.common": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "Run the common cross-profile checks (`cimcli validate --common`)."
        },
        "cimoxide.validation.quality": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "Run the CIMdesk modelling-quality checks (`cimcli validate --quality`)."
        },
        "cimoxide.validation.silence": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "markdownDescription": "Rule ids not to report (`cimcli validate --silence`)."
        },
        "cimoxide.validation.onType": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "Revalidate while typing, not only on open and save. Each run validates the whole model set — every CIM file in the document's directory."
        },
        "cimoxide.schema.rdfsDir": {
          "type": "string",
          "default": "",
          "markdownDescription": "RDFS directories to load class tables from instead of the built-in ones (`CIMOXIDE_RDFS_DIR`; a `PATH`-style list)."
        },
        "cimoxide.schema.shaclDir": {
          "type": "string",
          "default": "",
          "markdownDescription": "SHACL directories to load shapes from instead of the built-in ones (`CIMOXIDE_SHACL_DIR`; a `PATH`-style list)."
        },
        "cimoxide.mcp.enabled": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Offer the `cimmcp` MCP server to chat (Copilot agent mode and other MCP clients in VS Code): tools to list, summarise, search, validate and SPARQL-query the CGMES/NC model sets of the workspace."
        },
        "cimoxide.mcp.path": {
          "type": "string",
          "default": "",
          "markdownDescription": "Path to a `cimmcp` binary. Empty: the one bundled with the extension, else `cimmcp` on `PATH`."
        },
        "cimoxide.model.followCursor": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "Select the object at the cursor in the *CIM Model* view as the cursor moves. *cimoxide: Reveal in CIM Model* does it once."
        },
        "cimoxide.trace.server": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "description": "Trace the communication between VS Code and the language server."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run build -- --minify && node -e \"require('fs').copyFileSync('../../LICENSE', 'LICENSE')\"",
    "build": "esbuild src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node --target=node18 && esbuild src/webview/grid.ts --bundle --outfile=dist/grid.js --format=iife --platform=browser --target=es2020",
    "watch": "npm run build -- --sourcemap --watch",
    "typecheck": "tsc --noEmit && tsc --noEmit -p src/webview",
    "package": "vsce package"
  },
  "dependencies": {
    "cytoscape": "3.33.1",
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@types/node": "^18.19.0",
    "@types/vscode": "~1.101.0",
    "@vscode/vsce": "^3.2.0",
    "esbuild": "^0.24.0",
    "typescript": "^5.6.0"
  }
}
